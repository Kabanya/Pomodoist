COMPOSE_PROJECT_NAME=pomodoist-selfhost
# ECR allows one anonymous image pull per second; avoid simultaneous pulls.
COMPOSE_PARALLEL_LIMIT=1
BIND_ADDRESS=127.0.0.1
API_PORT=55421
WEB_PORT=58080

SUPABASE_PUBLIC_URL=http://localhost:55421
API_EXTERNAL_URL=http://localhost:55421/auth/v1
SITE_URL=http://localhost:58080
ADDITIONAL_REDIRECT_URLS=http://localhost:58080/login-callback,http://localhost:58080/auth/challenge,pomodoist://login-callback,pomodoist://captcha-callback

POSTGRES_PASSWORD=generate-with-make-setup
JWT_SECRET=generate-with-make-setup
JWT_KEYS=generate-with-make-setup
JWT_JWKS=generate-with-make-setup
ANON_KEY=generate-with-make-setup
SERVICE_ROLE_KEY=generate-with-make-setup
SECRET_KEY_BASE=generate-with-make-setup
REALTIME_DB_ENC_KEY=generate-with-make-setup
POMODOIST_RELEASE=generate-with-make-setup

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false
JWT_EXPIRY=3600
SMTP_ADMIN_EMAIL=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Pomodoist

GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=
TURNSTILE_SITE_KEY=
SENTRY_DSN=

CEREBRAS_API_KEY=
POMODOIST_OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
POMODOIST_TELEGRAM_BOT_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_WORKER_SECRET=
POMODOIST_MCP_ALLOWED_ORIGINS=http://localhost:58080

STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_LIFETIME_LAUNCH=
STRIPE_COUPON_MONTHLY_INTRO=
STRIPE_COUPON_ANNUAL_INTRO=
