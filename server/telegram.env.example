# Add these to the existing ignored server/.env or your deployment's secret store.
# Never commit real values. The webhook secret must be random, 32-256 characters,
# using A-Z, a-z, 0-9, underscore or hyphen. For example: openssl rand -hex 32
POMODOIST_TELEGRAM_BOT_TOKEN=
POMODOIST_TELEGRAM_WEBHOOK_SECRET=
POMODOIST_TELEGRAM_TIME_ZONE=UTC
# Optional override for the setup tool; otherwise SUPABASE_PUBLIC_URL is used.
POMODOIST_TELEGRAM_WEBHOOK_URL=
