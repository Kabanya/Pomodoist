<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.finchforge.pomodoist</id>
  <name>Pomodoist</name>
  <summary>Plan tasks and protect focused work sessions</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="com.finchforge">
    <name>FinchForge LLC</name>
  </developer>
  <description>
    <p>
      Pomodoist combines task planning, Pomodoro focus sessions, and
      productivity reports in one desktop application.
    </p>
  </description>
  <launchable type="desktop-id">com.finchforge.pomodoist.desktop</launchable>
  <provides>
    <binary>pomodoist</binary>
  </provides>
  <url type="homepage">https://pomodoist.com</url>
  <url type="bugtracker">https://github.com/Kabanya/Pomodoist/issues</url>
  <releases>
    <release version="@VERSION@" date="@RELEASE_DATE@"/>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
