.dart_tool/
# The trailing-slash rules above only match directories, while the Flutter
# project links its build output and Dart tool state to the repository-root
# build directory. Those links are created by tool/link-build.sh, so the
# symlink form needs an explicit rule or it shows up as untracked.
apps/flutter/.dart_tool
apps/flutter/build
.flutter-plugins-dependencies
pubspec_overrides.yaml
.pub-cache/
.pub/
/build/
/coverage/
/.worktrees/
/android/.gradle/
/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
/android/local.properties
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GeneratedPluginRegistrant.h
/ios/Runner/GeneratedPluginRegistrant.m
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/
/windows/flutter/ephemeral/

# Generated sidecar files for the checked-in Drift web worker asset.
/web/drift_worker.js.deps
/web/drift_worker.js.map

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Binary assets are ignored by default. The icon masters and the per-flavor
# icon sets listed below are deliberate exceptions and must remain tracked.
**.png
pomodoist_app_icon_no_background.png

# Tracked icon masters, the source of truth for the icon generator.
!apps/flutter/assets/branding/app_icons/pomodoist_icon_development.png
!apps/flutter/assets/branding/app_icons/pomodoist_icon_staging.png
!apps/flutter/assets/branding/app_icons/pomodoist_icon_production.png

# Tracked Android launcher icons: the shared main source set plus each flavor.
!apps/flutter/android/app/src/main/res/mipmap-*/ic_launcher.png
!apps/flutter/android/app/src/*/res/mipmap-*/ic_launcher.png

# Tracked Apple app icons: iOS app, watch app and macOS app, default plus flavors.
!apps/flutter/ios/Runner/Assets.xcassets/AppIcon*.appiconset/*.png
!apps/flutter/ios/PomodoistWatch/Assets.xcassets/AppIcon*.appiconset/*.png
!apps/flutter/macos/Runner/Assets.xcassets/AppIcon*.appiconset/*.png
!apps/flutter/ios/Runner/pomodoist_app_icon_no_background.png

# Tracked web icons: shared root assets plus each flavor directory.
!apps/flutter/web/favicon.png
!apps/flutter/web/icons/*.png
!apps/flutter/web/icons/*/*.png
