# Bundle the offline GNOME helper without requiring a running GNOME Shell.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(POMO_GNOME_EXTENSION_UUID "pomo@pomodoist.com")
set(POMO_GNOME_EXTENSION_SOURCE
  "${CMAKE_CURRENT_SOURCE_DIR}/gnome-extension/${POMO_GNOME_EXTENSION_UUID}")
set(POMO_GNOME_EXTENSION_PACKAGER
  "${CMAKE_CURRENT_SOURCE_DIR}/../../../tool/linux/package_gnome_extension.py")
set(POMO_GNOME_EXTENSION_ZIP
  "${CMAKE_CURRENT_BINARY_DIR}/gnome-extension/${POMO_GNOME_EXTENSION_UUID}.shell-extension.zip")
file(GLOB_RECURSE POMO_GNOME_EXTENSION_FILES CONFIGURE_DEPENDS
  "${POMO_GNOME_EXTENSION_SOURCE}/*.js"
  "${POMO_GNOME_EXTENSION_SOURCE}/*.json"
  "${POMO_GNOME_EXTENSION_SOURCE}/*.xml"
  "${POMO_GNOME_EXTENSION_SOURCE}/*.md"
  "${POMO_GNOME_EXTENSION_SOURCE}/LICENSE")
list(FILTER POMO_GNOME_EXTENSION_FILES EXCLUDE REGEX "/tests/")
add_custom_command(OUTPUT "${POMO_GNOME_EXTENSION_ZIP}"
  COMMAND "${Python3_EXECUTABLE}" "${POMO_GNOME_EXTENSION_PACKAGER}"
    --source "${POMO_GNOME_EXTENSION_SOURCE}"
    --output "${POMO_GNOME_EXTENSION_ZIP}"
  DEPENDS ${POMO_GNOME_EXTENSION_FILES} "${POMO_GNOME_EXTENSION_PACKAGER}"
  COMMENT "Packaging the offline Pomo GNOME extension"
  VERBATIM)
add_custom_target(pomo_gnome_extension ALL DEPENDS "${POMO_GNOME_EXTENSION_ZIP}")
add_dependencies(${BINARY_NAME} pomo_gnome_extension)
install(FILES "${POMO_GNOME_EXTENSION_ZIP}"
  DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/gnome-extension" COMPONENT Runtime)
install(DIRECTORY "${POMO_GNOME_EXTENSION_SOURCE}/"
  DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/gnome-extension/${POMO_GNOME_EXTENSION_UUID}"
  COMPONENT Runtime PATTERN "tests" EXCLUDE PATTERN ".*" EXCLUDE)
