// Generated by CMake from flavor_config.h.in. Do not edit.
//
// The values are set in windows/CMakeLists.txt, which mirrors
// apps/flutter/lib/domain/models/app_flavor.dart. That Dart file is the single
// source of truth for every flavor identity; the values here have to match it
// cell for cell.
//
// This header is included by both the runner's C++ sources and Runner.rc, so it
// has to stay within what the resource compiler's preprocessor accepts: plain
// object-like macros and string literals. The _WIDE variants use L"..." and are
// only ever expanded from C++, never from the .rc file.

#ifndef POMODOIST_FLAVOR_CONFIG_H_
#define POMODOIST_FLAVOR_CONFIG_H_

// Flavor name as passed to `flutter build windows --flavor <name>`, or
// "production" for the unflavored build.
#define POMODOIST_FLAVOR_NAME "@POMODOIST_FLAVOR_NAME@"

// Exactly one of these is 1.
#define POMODOIST_FLAVOR_IS_DEVELOPMENT @POMODOIST_FLAVOR_IS_DEVELOPMENT@
#define POMODOIST_FLAVOR_IS_STAGING @POMODOIST_FLAVOR_IS_STAGING@
#define POMODOIST_FLAVOR_IS_PRODUCTION @POMODOIST_FLAVOR_IS_PRODUCTION@

// Frozen display name, e.g. "Pomodoist Dev". Used for the window title, the
// executable's version resource and the installer's shortcut name.
#define POMODOIST_FLAVOR_DISPLAY_NAME "@POMODOIST_FLAVOR_DISPLAY_NAME@"
#define POMODOIST_FLAVOR_DISPLAY_NAME_WIDE L"@POMODOIST_FLAVOR_DISPLAY_NAME@"

// Application id, e.g. "com.finchforge.pomodoist.dev". This is the explicit
// AppUserModelID the process sets, so that the three flavors get three distinct
// taskbar and toast identities.
#define POMODOIST_FLAVOR_APPLICATION_ID "@POMODOIST_FLAVOR_APPLICATION_ID@"
#define POMODOIST_FLAVOR_APPLICATION_ID_WIDE L"@POMODOIST_FLAVOR_APPLICATION_ID@"

// Custom URL scheme registered by the installer, e.g. "pomodoist-dev".
#define POMODOIST_FLAVOR_URL_SCHEME "@POMODOIST_FLAVOR_URL_SCHEME@"

// Toast activator CLSID, e.g. "c4d2e8b3-6f75-4029-ab1c-3e8d7f209b45". The
// installer writes it as the shortcut's AppUserModelToastActivatorCLSID.
#define POMODOIST_FLAVOR_TOAST_GUID "@POMODOIST_FLAVOR_TOAST_GUID@"

// Window class of the runner's top-level window. Production keeps Flutter's
// conventional class name; the other flavors get their own so that
// single-instance forwarding can never reach across builds.
#define POMODOIST_FLAVOR_WINDOW_CLASS "@POMODOIST_FLAVOR_WINDOW_CLASS@"
#define POMODOIST_FLAVOR_WINDOW_CLASS_WIDE L"@POMODOIST_FLAVOR_WINDOW_CLASS@"

#endif // POMODOIST_FLAVOR_CONFIG_H_
