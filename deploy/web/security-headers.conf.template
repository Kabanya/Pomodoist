add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "$pomodoist_x_frame_options" always;
add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors $pomodoist_frame_ancestors; form-action 'self' https://accounts.google.com https://appleid.apple.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://browser.sentry-cdn.com https://www.gstatic.com __TURNSTILE_ORIGIN__ https://accounts.google.com https://apis.google.com https://appleid.cdn-apple.com $pomodoist_telegram_script_origin; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: https://*.googleusercontent.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.gstatic.com https://fonts.gstatic.com __SUPABASE_HTTP_ORIGIN__ __SUPABASE_WS_ORIGIN__ https://accounts.google.com https://oauth2.googleapis.com __SENTRY_ORIGIN__; frame-src __TURNSTILE_ORIGIN__ https://accounts.google.com https://appleid.apple.com; worker-src 'self' blob:; manifest-src 'self'" always;
