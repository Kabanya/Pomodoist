# Public template for `make setup-flutter`.
# Never put real secrets in this tracked file. Fill the ignored `.env.setup`.

# Local Flutter runs.
LOCAL__POMODOIST_ENVIRONMENT=local
LOCAL__WEB_APP_URL=
LOCAL__POMODOIST_REGISTRATION_URL=
LOCAL__SUPABASE_URL=
LOCAL__SUPABASE_ANON_KEY=
LOCAL__TURNSTILE_SITE_KEY=
LOCAL__SENTRY_DSN=
LOCAL__GOOGLE_WEB_CLIENT_ID=
LOCAL__DEEPSEEK_API_KEY=
LOCAL__POMODOIST_BILLING_CHANNEL=storekit
LOCAL__POMODOIST_DEV_UNLOCK=0
LOCAL__POMODOIST_LOCAL_STOREKIT=0

# Staging web/runtime configuration.
STAGING__POMODOIST_ENVIRONMENT=staging
STAGING__POMODOIST_WEB_URL=
STAGING__WEB_APP_URL=
STAGING__POMODOIST_REGISTRATION_URL=
STAGING__SUPABASE_URL=
STAGING__SUPABASE_ANON_KEY=
STAGING__TURNSTILE_SITE_KEY=
STAGING__SENTRY_DSN=
STAGING__GOOGLE_WEB_CLIENT_ID=
STAGING__POMODOIST_BILLING_CHANNEL=stripe

# Public production values compiled into TestFlight clients.
TESTFLIGHT__POMODOIST_ENVIRONMENT=production
TESTFLIGHT__WEB_APP_URL=
TESTFLIGHT__POMODOIST_REGISTRATION_URL=
TESTFLIGHT__SUPABASE_URL=
TESTFLIGHT__SUPABASE_ANON_KEY=
TESTFLIGHT__TURNSTILE_SITE_KEY=
TESTFLIGHT__SENTRY_DSN=
TESTFLIGHT__GOOGLE_WEB_CLIENT_ID=
TESTFLIGHT__GOOGLE_CLIENT_ID=
TESTFLIGHT__GOOGLE_REVERSED_CLIENT_ID=
TESTFLIGHT__POMODOIST_BILLING_CHANNEL=storekit

# Windows production builds.
WINDOWS__POMODOIST_ENVIRONMENT=production
WINDOWS__WEB_APP_URL=
WINDOWS__POMODOIST_REGISTRATION_URL=
WINDOWS__SUPABASE_URL=
WINDOWS__SUPABASE_ANON_KEY=
WINDOWS__TURNSTILE_SITE_KEY=
WINDOWS__SENTRY_DSN=
WINDOWS__GOOGLE_DESKTOP_CLIENT_ID=
WINDOWS__GOOGLE_DESKTOP_CLIENT_SECRET=
WINDOWS__POMODOIST_BILLING_CHANNEL=stripe

# Linux production builds.
LINUX__POMODOIST_ENVIRONMENT=production
LINUX__WEB_APP_URL=
LINUX__POMODOIST_REGISTRATION_URL=
LINUX__SUPABASE_URL=
LINUX__SUPABASE_ANON_KEY=
LINUX__TURNSTILE_SITE_KEY=
LINUX__SENTRY_DSN=
LINUX__GOOGLE_DESKTOP_CLIENT_ID=
LINUX__GOOGLE_DESKTOP_CLIENT_SECRET=
LINUX__POMODOIST_BILLING_CHANNEL=stripe

# Operational and server-side secrets. These only generate `.env.private`.
PRIVATE__ASC_KEY_ID=
PRIVATE__ASC_ISSUER_ID=
PRIVATE__ASC_PRIVATE_KEY_BASE64=
PRIVATE__APPLE_KEY_NAME=
PRIVATE__APPLE_TEAM_ID=
PRIVATE__APPLE_KEY_ID=
PRIVATE__APPLE_SERVICE_ID=
PRIVATE__APPLE_NATIVE_CLIENT_ID=
PRIVATE__APPLE_CALLBACK_URL=
PRIVATE__APPLE_PRIVATE_KEY_BASE64=
PRIVATE__APPLE_SECRET_VALID_DAYS=180
PRIVATE__STRIPE_SECRET_KEY=
PRIVATE__STRIPE_WEBHOOK_SECRET=
PRIVATE__OD_PUBLIC_WEB_URL=
PRIVATE__DEEPINFRA_API_KEY=
PRIVATE__OPENAI_API_KEY=
PRIVATE__OPENROUTER_API_KEY=
PRIVATE__REVIEW_ACCOUNT_EMAIL=
PRIVATE__REVIEW_ACCOUNT_PASSWORD=
PRIVATE__SUPABASE_TEST_DB_USER=
PRIVATE__SUPABASE_TEST_DB_PASSWORD=
PRIVATE__POMODOIST_TELEGRAM_BOT_TOKEN=

# Local deployment orchestration. Real values generate ignored `.env.deploy`.
DEPLOY__RUNNER=
DEPLOY__BACKEND_DIR=
DEPLOY__API_BASE_URL=
DEPLOY__API_TOKEN=
DEPLOY__WEB_STAGING_TRIGGER_URL=
DEPLOY__WEB_PRODUCTION_TRIGGER_URL=
DEPLOY__WEB_STAGING_URL=
DEPLOY__WEB_PRODUCTION_URL=
